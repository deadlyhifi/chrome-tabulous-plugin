{
  "manifest_version": 3,
  "name": "Tabulous",
  "version": "1.1.0",
  "description": "A tiled overview of every open tab across all your Chrome windows.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Tabulous"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "commands": {
    "open-tiles-view": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Tabulous"
    }
  },
  "permissions": ["tabs", "tabGroups", "storage", "favicon"],
  "optional_permissions": ["processes"],
  "optional_host_permissions": ["<all_urls>"],
  "icons": {
    "16": "src/assets/icon-16.png",
    "32": "src/assets/icon-32.png",
    "48": "src/assets/icon-48.png",
    "128": "src/assets/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"],
      "extension_ids": []
    }
  ]
}
